{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@flapfitapp.com",
        "EXPO_PUBLIC_PRIVACY_URL": "https://flapfitapp.com/privacy/",
        "EXPO_PUBLIC_TERMS_URL": "https://flapfitapp.com/terms/",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "https://flapfitapp.com/delete-account/",
        "EXPO_PUBLIC_MARKETING_URL": "https://flapfitapp.com/"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@flapfitapp.com",
        "EXPO_PUBLIC_PRIVACY_URL": "https://flapfitapp.com/privacy/",
        "EXPO_PUBLIC_TERMS_URL": "https://flapfitapp.com/terms/",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "https://flapfitapp.com/delete-account/",
        "EXPO_PUBLIC_MARKETING_URL": "https://flapfitapp.com/"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@flapfitapp.com",
        "EXPO_PUBLIC_PRIVACY_URL": "https://flapfitapp.com/privacy/",
        "EXPO_PUBLIC_TERMS_URL": "https://flapfitapp.com/terms/",
        "EXPO_PUBLIC_ACCOUNT_DELETION_URL": "https://flapfitapp.com/delete-account/",
        "EXPO_PUBLIC_MARKETING_URL": "https://flapfitapp.com/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
