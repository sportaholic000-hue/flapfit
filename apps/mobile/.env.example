# Public release contact and policy links. These values are intentionally safe
# to bundle in the app. Set the real values in EAS before a store build.
EXPO_PUBLIC_SUPPORT_EMAIL=support@flapfitapp.com
EXPO_PUBLIC_PRIVACY_URL=https://flapfitapp.com/privacy/
EXPO_PUBLIC_TERMS_URL=https://flapfitapp.com/terms/
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://flapfitapp.com/delete-account/
EXPO_PUBLIC_MARKETING_URL=https://flapfitapp.com/
EXPO_PUBLIC_IOS_APP_URL=
EXPO_PUBLIC_ANDROID_APP_URL=

# Dedicated Flap Fit Supabase client values. The publishable key is safe to
# bundle; never put a service-role key in a mobile or EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set only after physical Form Test approval. This must exactly match the
# versioned rules marker in scriptFormTracking.ts for production builds.
FLAPFIT_APPROVED_TRACKER_RULES_VERSION=

# Added only after the approved AdMob + RevenueCat implementation. Google test
# ad-unit IDs are allowed in development/preview; production requires live IDs.
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
