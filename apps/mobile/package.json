{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "eas-build-post-install": "node ./scripts/eas-build-post-install.cjs",
    "start:expo-go": "node ./scripts/start-expo-go.cjs",
    "start:expo-go:tunnel": "node ./scripts/start-expo-go.cjs --tunnel",
    "release:check": "node ./scripts/validate-release-config.cjs",
    "release:links": "node ./scripts/check-release-links.cjs",
    "release:assets": "node ./scripts/validate-store-assets.cjs",
    "verify:competition": "node ./scripts/verify-live-competition.cjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "eas-build-on-success": "node ./scripts/retain-ios-archive.cjs",
    "ota:check": "node ./scripts/validate-update-config.cjs production"
  },
  "dependencies": {
    "@expo/ngrok": "4.1.3",
    "@mediapipe/tasks-vision": "0.10.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.109.0",
    "@tanstack/react-query": "5.72.2",
    "buffer": "5.7.1",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-mail-composer": "57.0.2",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-sms": "patch:expo-sms@npm%3A57.0.2#~/.yarn/patches/expo-sms-npm-57.0.2-32281c0cc4.patch",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "0.525.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "patch:react-native-google-mobile-ads@npm%3A16.5.0#~/.yarn/patches/react-native-google-mobile-ads-npm-16.5.0-flapfit.patch",
    "react-native-purchases": "10.9.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native/jest-preset": "0.86.3",
    "@tailwindcss/postcss": "4.1.18",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "autoprefixer": "10.4.20",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "postcss": "8.5.28",
    "tailwind-scrollbar": "3.1.0",
    "tailwindcss": "3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^punycode$": "punycode/"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.cjs"
    ]
  }
}
